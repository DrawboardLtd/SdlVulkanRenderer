<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <VersionPrefix>6.24.0</VersionPrefix>
    <AssemblyVersion>6.20.0.0</AssemblyVersion>
    <PackageID>SdlVulkan.Renderer</PackageID>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/DrawboardLtd/SdlVulkanRenderer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../DeviceIndependentRenderingLibrary/src/DIR.Lib/DIR.Lib.csproj" />
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="Vortice.Vulkan" />
  </ItemGroup>

  <!--
    Shaders are authored as GLSL 450 in Shaders/*.vert|*.frag and pre-baked to SPIR-V under
    Shaders/spirv/*.spv by the tools/BakeShaders tool (committed). The renderer embeds the .spv and
    loads it at runtime, so the shipped package carries NO shaderc dependency and does NO runtime
    GLSL to SPIR-V compilation (which cost hundreds of ms building the first renderer). Re-bake and
    commit the .spv when a shader changes (see the SVR0001 build warning below for the command).
    (.vert/.frag are already visible in the IDE via the SDK's default None glob.)
  -->
  <ItemGroup>
    <None Remove="Shaders\spirv\*.spv" />
    <EmbeddedResource Include="Shaders\spirv\*.spv">
      <LogicalName>SdlVulkan.Renderer.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ShaderSource Include="Shaders\*.vert;Shaders\*.frag" />
  </ItemGroup>

  <!-- Warn (never fail) when a shader source is newer than its baked .spv, so an edit that forgets
       to re-bake is visible. Timestamp-based: fires in a dev tree right after an edit; a fresh clone
       has near-equal checkout times so it stays quiet on CI. -->
  <Target Name="WarnStaleBakedShaders" BeforeTargets="CoreCompile"
          Inputs="@(ShaderSource)"
          Outputs="@(ShaderSource->'Shaders\spirv\%(Filename)%(Extension).spv')">
    <Warning Code="SVR0001"
             Text="Shader source(s) newer than baked SPIR-V; re-run 'dotnet run --project tools/BakeShaders -c Release -- src/SdlVulkan.Renderer/Shaders' and commit Shaders/spirv/*.spv. Stale: @(ShaderSource)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
